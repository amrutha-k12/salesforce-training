public class ApplicationTriggerHandler {

    public static void beforeInsert(List<Application__c> newApplications){

        Set<Id> studentIds = new Set<Id>();
        Set<Id> jobIds = new Set<Id>();

        for(Application__c app : newApplications){

            if(app.Student__c != null)
                studentIds.add(app.Student__c);

            if(app.Job__c != null)
                jobIds.add(app.Job__c);

        }

        Map<Id, Student__c> studentMap =
            new Map<Id, Student__c>(
                [SELECT Id, CGPA__c
                 FROM Student__c
                 WHERE Id IN :studentIds]
            );

        Map<Id, Job__c> jobMap =
            new Map<Id, Job__c>(
                [SELECT Id,
                        Minimum_CGPA__c,
                        Last_Date__c
                 FROM Job__c
                 WHERE Id IN :jobIds]
            );

        List<Application__c> existingApps = [

            SELECT Student__c,
                   Job__c

            FROM Application__c

            WHERE Student__c IN :studentIds

            AND Job__c IN :jobIds

        ];

        Set<String> existingPairs = new Set<String>();

        for(Application__c app : existingApps){

            existingPairs.add(app.Student__c + '-' + app.Job__c);

        }

        for(Application__c app : newApplications){

            Student__c student = studentMap.get(app.Student__c);

            Job__c job = jobMap.get(app.Job__c);

            if(existingPairs.contains(app.Student__c + '-' + app.Job__c)){

                app.addError('Duplicate Application.');

            }

            if(student != null && job != null){

                if(student.CGPA__c < job.Minimum_CGPA__c){

                    app.addError('CGPA below minimum requirement.');

                }

                if(Date.today() > job.Last_Date__c){

                    app.addError('Application deadline has passed.');

                }

            }

            app.Status__c = 'Applied';

        }

    }

}
